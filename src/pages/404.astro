---
import Layout from '../layouts/Layout.astro'
---

<Layout title="404 | Brendon Hablutzel">
  <div class="w-screen overflow-hidden">
    <div class="mt-[30vh] p-5 flex flex-col items-center h-full">
      <div class="flex flex-col items-center gap-6">
        <h1 class="text-center text-4xl font-medium">404</h1>
        <h2 class="text-lg text-gray-600 tracking-wide text-center">
          Page not found
        </h2>
        <div
          class="flex justify-center items-center hover:shadow-lg transition-shadow duration-200 hover:cursor-pointer text-white bg-black rounded-xl font-light"
        >
          <a
            href="/"
            class="h-full w-full text-center flex items-center px-3 py-2"
          >
            Home
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
